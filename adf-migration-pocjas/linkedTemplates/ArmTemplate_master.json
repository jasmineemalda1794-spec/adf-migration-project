{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-migration-pocjas"
		},
		"LS_ADLS_Raw_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_Raw'"
		},
		"LS_Source_AzureSql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Source_AzureSql'"
		},
		"LS_Target_AzureSql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Target_AzureSql'"
		},
		"LS_ADLS_Raw_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagemigrationjas.dfs.core.windows.net/"
		},
		"LS_Source_AzureSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-migration-source-jas.database.windows.net"
		},
		"LS_Source_AzureSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Source_DB"
		},
		"LS_Source_AzureSql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "jasmine_dbmanager"
		},
		"LS_Target_AzureSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-migration-source-jas.database.windows.net"
		},
		"LS_Target_AzureSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Target_DB"
		},
		"LS_Target_AzureSql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "jasmine_dbmanager"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-migration-pocjas_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Raw_accountKey": {
						"value": "[parameters('LS_ADLS_Raw_accountKey')]"
					},
					"LS_Source_AzureSql_password": {
						"value": "[parameters('LS_Source_AzureSql_password')]"
					},
					"LS_Target_AzureSql_password": {
						"value": "[parameters('LS_Target_AzureSql_password')]"
					},
					"LS_ADLS_Raw_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Raw_properties_typeProperties_url')]"
					},
					"LS_Source_AzureSql_properties_typeProperties_server": {
						"value": "[parameters('LS_Source_AzureSql_properties_typeProperties_server')]"
					},
					"LS_Source_AzureSql_properties_typeProperties_database": {
						"value": "[parameters('LS_Source_AzureSql_properties_typeProperties_database')]"
					},
					"LS_Source_AzureSql_properties_typeProperties_userName": {
						"value": "[parameters('LS_Source_AzureSql_properties_typeProperties_userName')]"
					},
					"LS_Target_AzureSql_properties_typeProperties_server": {
						"value": "[parameters('LS_Target_AzureSql_properties_typeProperties_server')]"
					},
					"LS_Target_AzureSql_properties_typeProperties_database": {
						"value": "[parameters('LS_Target_AzureSql_properties_typeProperties_database')]"
					},
					"LS_Target_AzureSql_properties_typeProperties_userName": {
						"value": "[parameters('LS_Target_AzureSql_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}